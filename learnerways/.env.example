# Auth
BETTER_AUTH_SECRET=PASTE_32_BYTE_SECRET_HERE
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI
# OpenAI (paid): fill OPENAI_API_KEY
# OpenRouter (free tier): fill OPENROUTER_API_KEY — it takes priority
OPENAI_API_KEY=PASTE_YOUR_OPENAI_API_KEY_HERE
OPENROUTER_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1 (set automatically when OPENROUTER_API_KEY is filled)
# OPENAI_MODEL=openrouter/free
# TTS_VOICE=en-US-JennyNeural
# OPTIONAL: route OpenAI requests to a local stub for E2E tests
# OPENAI_BASE_URL=http://localhost:8788/v1

# OPTIONAL overrides (used by `playwright test`)
# DB_PATH=./e2e/test.db
# GENERATION_COOLDOWN_MS=200

# OPTIONAL: email transport for password reset (falls back to console logger)
# RESEND_API_KEY=